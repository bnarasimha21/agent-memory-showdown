# LLM provider: "do" (Claude via DigitalOcean Serverless Inference, paid) or
# "fake" (deterministic offline model for tests and sample runs, free).
LLM_PROVIDER=do

# DigitalOcean Serverless Inference (needed when LLM_PROVIDER=do)
DO_API_KEY=dop_v1_your-key-here

# LLM (Claude via DO Serverless Inference)
LLM_MODEL=anthropic-claude-4.5-sonnet

# Retries on HTTP 429/5xx, connection errors and timeouts (src/retry.py):
# up to LLM_MAX_RETRIES retries, LLM_RETRY_BASE_S * 2**n seconds apart.
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_S=2

# Judge for scoring probe responses (src/scoring/judge_prompt.md).
# JUDGE_PROVIDER defaults to LLM_PROVIDER. JUDGE=0 skips judging at run end.
# The default judge is the answering model, which may favour its own answers
# (self-preference); set a different model here if your provider offers one.
JUDGE_MODEL=anthropic-claude-4.5-sonnet
JUDGE=1

# Embedding model: local sentence-transformers, run on CPU (no API call).
# EMBEDDING_DIMENSION must equal the model output size (all-MiniLM-L6-v2 = 384)
# and the vector(384) column in scripts/init_pgvector.sql.
# EMBEDDING_PROVIDER: "local" (sentence-transformers) or "fake" (hashing, tests).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark
POSTGRES_DB=memory_bench

# Benchmark parameters
NUM_RUNS=5
NUM_TURNS=50
# Facts planted per run, by category (data/facts_v2.yaml). Each run seed
# samples its own facts, values and positions. Sensitive facts are reported
# separately and left out of the headline recall.
FACTS_PER_CATEGORY=extraction=3,update=2,temporal=1,multi_hop=1,abstention=2,sensitive=2
# 1 adds a distractor turn per fact (same kind of thing, different value)
DISTRACTORS=1
# Recall checkpoints: after these turns, every fact planted so far is probed
# (read-only). Replaces RECALL_TURNS, which is still read as a fallback.
CHECKPOINTS=15,25,35,50
# Top-k memories retrieved by the vector backends
RETRIEVAL_K=4

# Output
RESULTS_DIR=results
