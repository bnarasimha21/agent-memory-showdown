# DigitalOcean Serverless Inference
DO_API_KEY=dop_v1_your-key-here

# LLM (Claude via DO Serverless Inference)
LLM_MODEL=anthropic-claude-4.5-sonnet

# Embedding model: local sentence-transformers, run on CPU (no API call).
# EMBEDDING_DIMENSION must equal the model output size (all-MiniLM-L6-v2 = 384)
# and the vector(384) column in scripts/init_pgvector.sql.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark
POSTGRES_DB=memory_bench

# Benchmark parameters
NUM_RUNS=5
NUM_TURNS=50
SEED_TURNS=1,3,7,12,18,25,30,35,40,45
RECALL_TURNS=15,25,35,50

# Output
RESULTS_DIR=results
